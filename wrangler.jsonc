// Cloudflare Workers config for the static site (assets only, no Worker
// script). `name` must match the Worker name in the Cloudflare dashboard.
// The site is built into _site/ by `make html`.
{
  "name": "portfolio",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./_site",
    // Serve 404.html (built from content/404.typ) for unknown URLs
    "not_found_handling": "404-page",
    // Pages live at /<dir>/ (built as <dir>/index.html); /<dir> redirects
    // there. The 301s themselves come from _site/_redirects (see Makefile).
    "html_handling": "force-trailing-slash"
  }
}
